---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, otherLangPath, site, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  og?: string;
  noCta?: boolean;
}

const { lang, title, description, og, noCta = false } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'id' ? 'en' : 'id';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://dandie.pages.dev';
const pathname = Astro.url.pathname;
const canonical = `${siteUrl}${pathname}`;
const alternate = `${siteUrl}${otherLangPath(pathname, other)}`;
const ogImage = `${siteUrl}${og ?? '/assets/og.png'}`;
---

<!doctype html>
<html lang={lang} data-backdrop="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${pathname.replace(/^\/en(?=\/|$)/, '') || '/'}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dandie Lucky Maulana" />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f8f6f1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>
      // Tema dipasang sebelum paint supaya tidak ada kedipan putih
      // saat pengunjung yang memilih tema gelap membuka halaman.
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      } catch (e) {}
    </script>

    <ClientRouter />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      url: siteUrl,
      image: `${siteUrl}/assets/about/portrait.jpg`,
      email: `mailto:${site.email}`,
      telephone: site.phone,
      jobTitle: 'Graphic Designer & Content Creator',
      address: { '@type': 'PostalAddress', addressLocality: 'Jakarta Selatan', addressCountry: 'ID' },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Politeknik Negeri Media Kreatif Jakarta',
      },
      sameAs: [site.linkedin, site.instagram].filter(Boolean),
      knowsAbout: [
        'Graphic Design',
        'Social Media Content',
        'Motion Graphics',
        'Video Editing',
        'Photography',
        'UI/UX Design',
        'Figma',
        'Adobe Creative Suite',
      ],
    })} />
  </head>

  <body data-lang={lang}>
    <a class="skip-link" href="#main">{t.ui.skip}</a>
    <div class="progress" aria-hidden="true"></div>

    <Header lang={lang} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} noCta={noCta} />

    <div class="hover-preview" aria-hidden="true" data-hover-preview>
      <img alt="" data-preview-img width="320" height="240" />
      <span class="label" data-preview-label></span>
    </div>

    <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Gambar diperbesar">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Tutup">✕</button>
      <img alt="" data-lightbox-img />
    </div>

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script>
      import '../scripts/site.js';
    </script>
    <script>
      import { initBackdrop } from '../scripts/backdrop';
      initBackdrop();
      document.addEventListener('astro:page-load', initBackdrop);
    </script>
  </body>
</html>
