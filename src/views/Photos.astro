---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { ui, href, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].photos;

/** Arsip foto lepas — berkasnya hasil impor scripts/import-assets.mjs
 *  dari folder Assets/Foto lain-lain. */
const photos = Array.from({ length: 11 }, (_, i) => {
  const n = String(i + 1).padStart(2, '0');
  return {
    src: `/assets/gallery/foto-${n}.jpg`,
    alt: lang === 'id' ? `Foto arsip ${i + 1}` : `Archive photograph ${i + 1}`,
  };
});
---

<Base lang={lang} title={t.title} description={t.description}>
  <section class="section" style="padding-top:calc(var(--header-h) + clamp(2.5rem,7vw,6rem))">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>{t.eyebrow} — {String(photos.length).padStart(2, '0')}</p>
        <h1 data-reveal style="--i:1">{t.headline}</h1>
        <p class="lede" data-reveal style="--i:2">{t.lede}</p>
      </div>

      <Gallery items={photos} natural />

      <p class="muted mono" data-reveal style="margin-top:var(--s4)">{t.note}</p>

      <p style="margin-top:var(--s7)" data-reveal>
        <a class="link-arrow" href={href('/work', lang)}>
          {lang === 'id' ? 'Lihat karya berbasis proyek' : 'See project-based work'} →
        </a>
      </p>
    </div>
  </section>
</Base>
